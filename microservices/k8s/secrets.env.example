# Copy to secrets.env (gitignored) and replace every value before deploying anywhere shared.
# Use a different random value for each of JWT_SECRET, WEBHOOK_SECRET_KEY and VAULT_MASTER_KEY
# (the two keys are 32 random bytes, base64: openssl rand -base64 32), and set ENFORCE_STRONG_SECRETS=true
# in infra/configmap.yaml so the services refuse to start on the committed defaults.
# kustomization.yaml turns secrets.env into the `app-secrets` Secret.
JWT_SECRET=change-me-dev-only-jwt-secret-at-least-64-characters-long-0123456789abcdef
WEBHOOK_SECRET_KEY=arXfSlAXS4TRCw5tlKCFSwjG+D4C4ESUV47We3pw2eI=
VAULT_MASTER_KEY=arXfSlAXS4TRCw5tlKCFSwjG+D4C4ESUV47We3pw2eI=

# Shared by every service for /internal/** calls. Leave unset locally (a development default is used).
# For anything shared, generate with:  openssl rand -base64 32
INTERNAL_API_TOKEN=change-me-generate-with-openssl-rand-base64-32

# Redis requires this password when set; leave empty for none. Generate with:  openssl rand -base64 24
REDIS_PASSWORD=

POSTGRES_PASSWORD=password
MERCHANT_DB_PASSWORD=password
PAYMENT_DB_PASSWORD=password
OPERATIONS_DB_PASSWORD=password
VAULT_DB_PASSWORD=password

# Grafana admin login (observability stack)
GRAFANA_ADMIN_PASSWORD=admin
